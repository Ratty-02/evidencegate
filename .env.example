PAYPAL_MOCK=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# Encrypts merchants' saved PayPal credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=
SESSION_SECRET=replace_with_a_long_random_string
SESSION_MAX_AGE_DAYS=7
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:8000
# dev: emails are not sent; links are shown on the page (demo only).
# smtp: send real email using the SMTP_* settings.
EMAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EvidenceGate <no-reply@example.com>
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
DATABASE_URL=sqlite:///./evidencegate.db
